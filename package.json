{
  "name": "dash-year-12-subject-pwa-coach",
  "version": "0.1.0",
  "description": "Offline-first PWA for Year 12 learning with AI coaching via MCP servers",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "workbox-build": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "idb-keyval": "^6.2.0",
    "chart.js": "^4.0.0"
  },
  "keywords": [
    "pwa",
    "education",
    "year-12",
    "nudgee-college",
    "qcaa",
    "learning",
    "mcp",
    "ai-coaching",
    "offline-first"
  ],
  "author": "Dashiel Withnall",
  "license": "MIT"
}
